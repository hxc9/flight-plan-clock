{
  "name": "autorouter-mock",
  "version": "1.0.0",
  "description": "AutoRouter API mock server",
  "main": "dist/index.js",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && concurrently \"tsc --watch\" \"nodemon -q dist/index.js\""
  },
  "engines": {
    "node": ">=10"
  },
  "dependencies": {
    "autorouter-dto": "workspace:*",
    "autorouter-mock-services": "workspace:*",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "generic-pool": "^3.9.0",
    "ioredis": "^5.4.1",
    "ioredis-rejson": "^1.0.10",
    "oauth2-server": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-oauth-server": "^2.0.8",
    "@types/node": "^20.16.10",
    "@types/oauth2-server": "^3.0.18",
    "concurrently": "^7.6.0",
    "eslint": "^7.32.0",
    "eslint-config-custom": "workspace:*",
    "nodemon": "^3.1.7",
    "rimraf": "latest",
    "ts-node": "^9.1.1",
    "tsconfig": "workspace:*",
    "typescript": "^5.6.2"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ]
}
